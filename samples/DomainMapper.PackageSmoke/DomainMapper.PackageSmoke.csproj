<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <TargetFramework Condition="'$(DomainMapperPackageSmokeTargetFramework)' != ''"
      >$(DomainMapperPackageSmokeTargetFramework)</TargetFramework>
    <DefineConstants Condition="'$(DomainMapperProjectionSmoke)' == 'true'"
      >$(DefineConstants);DOMAINMAPPER_PROJECTION_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DomainMapperNugetPackageVersion)' == ''">
    <ProjectReference Include="..\..\src\DomainMapper\DomainMapper.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference
      Include="..\..\src\DomainMapper.Abstractions\DomainMapper.Abstractions.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(DomainMapperNugetPackageVersion)' != ''">
    <PackageReference Include="DomainMapper" Version="$(DomainMapperNugetPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(DomainMapperProjectionSmoke)' == 'true' AND '$(DomainMapperNugetPackageVersion)' == ''">
    <ProjectReference Include="..\..\src\DomainMapper.Projections\DomainMapper.Projections.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(DomainMapperProjectionSmoke)' == 'true' AND '$(DomainMapperNugetPackageVersion)' != ''">
    <PackageReference Include="DomainMapper.Projections" Version="$(DomainMapperNugetPackageVersion)" />
  </ItemGroup>
</Project>
