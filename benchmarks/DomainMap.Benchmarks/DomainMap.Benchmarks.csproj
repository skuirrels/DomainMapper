<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Frameworks" Version="7.6.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q) affects the SQLite engine bundled by the transitive
      SQLitePCLRaw.lib.e_sqlite3 pulled in via the DomainMap.IntegrationTests project reference.
      This is a benchmark-only dependency, so we are not affected by the malformed-database
      vulnerability. Suppress the audit warning until EF Core ships a fixed bundle. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="$(PkgRiok_Mapperly)\analyzers\roslyn5.0\dotnet\cs\Riok.Mapperly.dll"
      TargetPath="Riok.Mapperly.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DomainMap\DomainMap.csproj" />
    <ProjectReference Include="..\..\src\DomainMap\DomainMap.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\DomainMap.Abstractions\DomainMap.Abstractions.csproj" />
    <ProjectReference
      Include="..\..\src\DomainMap.Abstractions\DomainMap.Abstractions.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="..\..\test\DomainMap.IntegrationTests\DomainMap.IntegrationTests.csproj" />
  </ItemGroup>
</Project>
