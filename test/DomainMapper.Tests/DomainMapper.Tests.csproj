<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Running every Roslyn-heavy generator test concurrently can exhaust the test host.
        Use xUnit's four-thread collection parallelism for a deterministic local and CI gate. -->
    <IncludeMeziantouXunitParallelTestFramework>false</IncludeMeziantouXunitParallelTestFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DomainMapper.Projections/DomainMapper.Projections.csproj" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.github\workflows\release.yml" Link="release.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DomainMapper\DomainMapper.csproj" />
    <ProjectReference Include="..\..\src\DomainMapper.Abstractions\DomainMapper.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\benchmarks\DomainMapper.Benchmarks\ComparisonBenchmarkGate.cs" Link="Benchmarking\ComparisonBenchmarkGate.cs" />
    <Compile Include="..\..\benchmarks\DomainMapper.Benchmarks\ComparisonCodeParity.cs" Link="Benchmarking\ComparisonCodeParity.cs" />
  </ItemGroup>
</Project>
