<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Running every Roslyn-heavy generator test concurrently can exhaust the test host.
        Use xUnit's four-thread collection parallelism for a deterministic local and CI gate. -->
    <IncludeMeziantouXunitParallelTestFramework>false</IncludeMeziantouXunitParallelTestFramework>
  </PropertyGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Verify.SourceGenerators" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DomainMap\DomainMap.csproj" />
    <ProjectReference Include="..\..\src\DomainMap.Abstractions\DomainMap.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\benchmarks\DomainMap.Benchmarks\ComparisonBenchmarkGate.cs" Link="Benchmarking\ComparisonBenchmarkGate.cs" />
  </ItemGroup>
</Project>
